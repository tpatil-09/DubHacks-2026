# Copy to background_check/.env (or keep using the repo-root .env, which is also read).
# Never commit real values.

# Required for live runs: token from `claude setup-token`. Used ONLY by the local
# Claude Code CLI (`claude -p`), never sent anywhere else by this project.
CLAUDE_CODE_OAUTH_TOKEN=

# claude_cli (default, live) | mock (deterministic fixtures, no network)
MODEL_PROVIDER=claude_cli
# Optional model alias or full name passed to `claude --model` (blank = CLI default)
MODEL_NAME=

# Optional supplementary search. Claude Code's WebSearch is the primary search path.
# none (default) | tavily
SEARCH_PROVIDER=none
TAVILY_API_KEY=

OUTPUT_DIR=./output
# Seconds per Claude Code agent session
AGENT_TIMEOUT_SECONDS=1200

# --- Official records APIs -------------------------------------------------
# Which records providers to query: courtlistener,checkr_trust (or none).
# Default: courtlistener, plus checkr_trust when its credentials are set.
RECORDS_PROVIDERS=
# CourtListener (free): sign up at https://www.courtlistener.com/sign-in/ and copy
# the token from https://www.courtlistener.com/profile/api-token/ . Works without a
# token at a very low rate limit (about 5 requests/minute).
COURTLISTENER_API_TOKEN=
# Checkr Trust (commercial, non-FCRA trust & safety): sex-offender registry and
# criminal checks. Request a test account from Checkr Trust; they issue a client id/secret.
CHECKR_TRUST_CLIENT_ID=
CHECKR_TRUST_CLIENT_SECRET=
CHECKR_TRUST_BASE_URL=https://api.checkrtrust.com/v1
