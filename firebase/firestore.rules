rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isMe(uid) { return signedIn() && request.auth.uid == uid; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Private account state. Users can't grant themselves roles or statuses.
    match /users/{uid} {
      allow read, delete: if isMe(uid);
      allow create: if isMe(uid)
        && request.resource.data.keys().hasOnly(['uid', 'email', 'onboardingStep', 'settings', 'createdAt', 'screeningConsentAt'])
        && request.resource.data.uid == uid;
      allow update: if isMe(uid) && onlyChanges(['onboardingStep', 'settings', 'screeningConsentAt']);
    }

    // Discoverable profiles: any signed-in user can read; only the owner can write.
    match /profiles/{uid} {
      function validProfile(data) {
        return data.keys().hasAll(['uid', 'displayName', 'age', 'gender', 'interestedIn', 'city', 'bio', 'prompts', 'photos', 'interests', 'discoverable', 'updatedAt'])
          && data.keys().hasOnly(['uid', 'displayName', 'age', 'gender', 'interestedIn', 'city', 'bio', 'prompts', 'photos', 'interests', 'quiz', 'discoverable', 'updatedAt'])
          && data.uid == uid
          && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 30
          && data.age is int && data.age >= 18 && data.age <= 120
          && data.gender in ['woman', 'man', 'nonbinary']
          && data.interestedIn is list && data.interestedIn.size() <= 3
          && data.bio is string && data.bio.size() <= 300
          && data.city is string && data.city.size() >= 2 && data.city.size() <= 40
          && data.photos is list && data.photos.size() <= 6
          && data.interests is list && data.interests.size() <= 10
          && data.prompts is list && data.prompts.size() <= 3
          && data.discoverable is bool
          && data.updatedAt is timestamp
          && !('birthdate' in data)
          && !('isDemo' in data);
      }
      allow read: if signedIn();
      allow create, update: if isMe(uid) && validProfile(request.resource.data);
      allow delete: if isMe(uid);
    }

    // Synthetic records are read-only; seed them only in the local emulator.
    match /demoProfiles/{demoId} {
      allow read: if signedIn();
      allow write: if false;
    }

    // likes/{fromUid_toUid}. Firebase UIDs never contain "_".
    match /likes/{likeId} {
      allow get: if signedIn()
        && (likeId.matches(request.auth.uid + '_.*') || likeId.matches('.*_' + request.auth.uid));
      allow list: if signedIn() && resource.data.from == request.auth.uid;
      allow create, update: if signedIn()
        && request.resource.data.from == request.auth.uid
        && likeId == request.auth.uid + '_' + request.resource.data.to
        && request.resource.data.type in ['like', 'pass'];
    }

    // A match can only be created when both players have liked each other.
    match /matches/{matchId} {
      function participant() { return signedIn() && request.auth.uid in resource.data.users; }
      function likedBy(from, to) {
        let like = /databases/$(database)/documents/likes/$(from + '_' + to);
        return exists(like) && get(like).data.type == 'like';
      }

      allow read: if participant();
      allow create: if signedIn()
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.auth.uid in request.resource.data.users
        && matchId == request.resource.data.users[0] + '_' + request.resource.data.users[1]
        && likedBy(request.resource.data.users[0], request.resource.data.users[1])
        && likedBy(request.resource.data.users[1], request.resource.data.users[0]);
      allow update: if participant() && onlyChanges(['lastMessageAt', 'lastMessagePreview']);
      allow delete: if participant();

      match /messages/{messageId} {
        function inMatch() {
          return signedIn() && request.auth.uid in get(/databases/$(database)/documents/matches/$(matchId)).data.users;
        }
        allow read: if inMatch();
        allow create: if inMatch()
          && request.resource.data.type in ['text', 'game_share', 'system']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && (request.resource.data.senderId == request.auth.uid
              || (request.resource.data.senderId == 'system' && request.resource.data.type == 'system'));
        // Players may only add their own answer to a shared game.
        allow update: if inMatch()
          && onlyChanges(['game'])
          && request.resource.data.game.answers.diff(resource.data.game.answers).affectedKeys().hasOnly([request.auth.uid]);
      }
    }

    match /quizResults/{uid} {
      allow read, write: if isMe(uid);
    }

    match /wyrAnswers/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid);
    }

    match /gameAnswers/{uid} {
      allow read: if signedIn();
      allow write: if isMe(uid);
    }

    function validNote(text) {
      return text is string && text.size() > 0 && text.size() <= 180;
    }
    function validDesign(design) {
      return design.keys().hasOnly(['color', 'ink', 'accent', 'pattern'])
        && design.pattern in ['solid', 'dots', 'stripes', 'grid', 'stars', 'waves', 'plaid', 'confetti']
        && design.color is string && design.color.size() <= 20
        && design.ink is string && design.ink.size() <= 20
        && design.accent is string && design.accent.size() <= 20;
    }
    function validReply(reply) {
      return reply.keys().hasOnly(['fromUid', 'text', 'createdAt'])
        && reply.fromUid == request.auth.uid
        && validNote(reply.text)
        && reply.createdAt is timestamp;
    }

    // Sender's copy. The catcher's id is not stored here, so the sender cannot read who received it.
    match /paperPlanes/{planeId} {
      allow read: if signedIn() && resource.data.fromUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'design', 'text', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && validNote(request.resource.data.text)
        && validDesign(request.resource.data.design)
        && request.resource.data.createdAt is timestamp;
      allow update: if signedIn()
        && !('reply' in resource.data)
        && onlyChanges(['reply'])
        && validReply(request.resource.data.reply)
        && exists(/databases/$(database)/documents/paperInboxes/$(request.auth.uid)/planes/$(planeId));
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    // Recipient's copy. Only they can read it, which is what keeps the catcher hidden from the sender.
    match /paperInboxes/{uid}/planes/{planeId} {
      allow read: if isMe(uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'design', 'text', 'createdAt', 'planeId'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid == uid
        && request.resource.data.toUid != request.resource.data.fromUid
        && request.resource.data.planeId == planeId
        && validNote(request.resource.data.text)
        && validDesign(request.resource.data.design)
        && exists(/databases/$(database)/documents/paperPlanes/$(planeId))
        && get(/databases/$(database)/documents/paperPlanes/$(planeId)).data.fromUid == request.auth.uid;
      allow update: if isMe(uid)
        && !('reply' in resource.data)
        && onlyChanges(['reply'])
        && validReply(request.resource.data.reply);
      allow delete: if isMe(uid);
    }

    // screenings/{uid}: the member's background check (report.json from background_check), written only by
    // the screening Cloud Function after the member consents at onboarding (Admin SDK bypasses rules).
    // Every signed-in member can read it; the UI shows only findings linked to the person.
    match /screenings/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /blocks/{uid}/blocked/{otherUid} {
      allow read, write: if isMe(uid);
    }

    // User reports go to moderators; reporters can submit but not read them back.
    match /reports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reason in ['harassment', 'fake', 'scam', 'underage', 'other']
        && request.resource.data.details.size() <= 1000;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
