rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function owner(uid) { return signedIn() && request.auth.uid == uid; }
    function pairId(a, b) {
      return a < b
        ? string(a.size()) + ':' + a + string(b.size()) + ':' + b
        : string(b.size()) + ':' + b + string(a.size()) + ':' + a;
    }
    function isMatchMember(matchId) {
      return signedIn()
        && exists(/databases/$(database)/documents/matches/$(matchId))
        && get(/databases/$(database)/documents/matches/$(matchId)).data.status == 'active'
        && get(/databases/$(database)/documents/matches/$(matchId)).data.users.hasAny([request.auth.uid]);
    }
    function profilesAreDiscoverable(fromUid, toUid) {
      return exists(/databases/$(database)/documents/profiles/$(fromUid))
        && exists(/databases/$(database)/documents/profiles/$(toUid))
        && get(/databases/$(database)/documents/profiles/$(fromUid)).data.discoverable == true
        && get(/databases/$(database)/documents/profiles/$(toUid)).data.discoverable == true;
    }
    function notBlocked(aUid, bUid) {
      return !exists(/databases/$(database)/documents/blocks/$(aUid + '_' + bUid))
        && !exists(/databases/$(database)/documents/blocks/$(bUid + '_' + aUid));
    }
    function genderGroup(gender) {
      return gender == 'woman' ? 'women' : (gender == 'man' ? 'men' : gender);
    }
    function mutualPreferencesMatch(aUid, bUid) {
      let aProfile = get(/databases/$(database)/documents/profiles/$(aUid)).data;
      let bProfile = get(/databases/$(database)/documents/profiles/$(bUid)).data;
      let aPrefsPath = /databases/$(database)/documents/preferences/$(aUid);
      let bPrefsPath = /databases/$(database)/documents/preferences/$(bUid);
      let aPrefs = exists(aPrefsPath) ? get(aPrefsPath).data : {};
      let bPrefs = exists(bPrefsPath) ? get(bPrefsPath).data : {};
      let aInterested = !aPrefs.keys().hasAny(['interestedIn']) || aPrefs.interestedIn.size() == 0
        || aPrefs.interestedIn.hasAny([genderGroup(bProfile.gender)]);
      let bInterested = !bPrefs.keys().hasAny(['interestedIn']) || bPrefs.interestedIn.size() == 0
        || bPrefs.interestedIn.hasAny([genderGroup(aProfile.gender)]);
      let aAgeOk = !aPrefs.keys().hasAny(['ageRange'])
        || (bProfile.age >= aPrefs.ageRange.min && bProfile.age <= aPrefs.ageRange.max);
      let bAgeOk = !bPrefs.keys().hasAny(['ageRange'])
        || (aProfile.age >= bPrefs.ageRange.min && aProfile.age <= bPrefs.ageRange.max);
      let aIntent = !aPrefs.keys().hasAny(['relationshipIntent']) || !bPrefs.keys().hasAny(['relationshipIntent'])
        || aPrefs.relationshipIntent == bPrefs.relationshipIntent
        || aPrefs.relationshipIntent == 'open' || bPrefs.relationshipIntent == 'open';
      return aInterested && bInterested && aAgeOk && bAgeOk && aIntent;
    }

    match /screenings/{uid} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /users/{uid} {
      allow read: if owner(uid);
      allow create: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'email', 'createdAt', 'updatedAt', 'onboardingStep', 'settings']);
      allow update: if owner(uid)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['email', 'updatedAt', 'onboardingStep', 'settings', 'screeningConsentAt']);
      allow delete: if owner(uid);
    }

    match /profiles/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || resource.data.discoverable == true);
      allow list: if signedIn() && resource.data.discoverable == true;
      allow create, update: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly([
          'uid', 'firstName', 'lastName', 'birthdate', 'displayName', 'age', 'gender', 'genderOther', 'pronouns', 'city', 'bio',
          'prompts', 'photos', 'interests', 'quiz', 'discoverable', 'isDemo', 'updatedAt'
        ])
        && (!('firstName' in request.resource.data) || (request.resource.data.firstName is string && request.resource.data.firstName.size() <= 30))
        && (!('lastName' in request.resource.data) || (request.resource.data.lastName is string && request.resource.data.lastName.size() <= 30))
        && (!('birthdate' in request.resource.data) || (request.resource.data.birthdate is string && request.resource.data.birthdate.size() == 10))
        && (!('displayName' in request.resource.data) || request.resource.data.displayName is string)
        && (!('age' in request.resource.data) || (request.resource.data.age is int && request.resource.data.age >= 18 && request.resource.data.age <= 120))
        && (!('gender' in request.resource.data) || request.resource.data.gender is string)
        && (!('city' in request.resource.data) || (request.resource.data.city is string && request.resource.data.city.size() <= 80))
        && (!('bio' in request.resource.data) || (request.resource.data.bio is string && request.resource.data.bio.size() <= 300))
        && (!('photos' in request.resource.data) || (request.resource.data.photos is list && request.resource.data.photos.size() <= 6))
        && (!('interests' in request.resource.data) || (request.resource.data.interests is list && request.resource.data.interests.size() <= 10))
        && (!('prompts' in request.resource.data) || (request.resource.data.prompts is list && request.resource.data.prompts.size() <= 3))
        && (!('discoverable' in request.resource.data) || request.resource.data.discoverable is bool);
      allow delete: if owner(uid);
    }

    match /preferences/{uid} {
      allow read, delete: if owner(uid);
      allow create, update: if owner(uid)
        && request.resource.data.uid == uid
        && request.resource.data.keys().hasOnly(['uid', 'interestedIn', 'interestedInOther', 'ageRange', 'relationshipIntent', 'updatedAt']);
    }

    match /likes/{likeId} {
      // A like that doesn't exist yet has no data, so allow that read by its id
      // ("<from>_<to>"); setLike checks for the reverse like before creating a match.
      allow get: if signedIn() && (resource == null
        ? (likeId.matches(request.auth.uid + '_.+') || likeId.matches('.+_' + request.auth.uid))
        : (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid));
      allow list: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create, update: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.action in ['like', 'pass']
        && profilesAreDiscoverable(request.auth.uid, request.resource.data.toUid)
        && notBlocked(request.auth.uid, request.resource.data.toUid)
        && (request.resource.data.action == 'pass'
          || mutualPreferencesMatch(request.auth.uid, request.resource.data.toUid))
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'action', 'createdAt', 'updatedAt']);
      allow delete: if signedIn() && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
    }

    match /matches/{matchId} {
      allow get: if signedIn() && (!exists(/databases/$(database)/documents/matches/$(matchId))
        || resource.data.users.hasAny([request.auth.uid]));
      allow list: if signedIn() && resource.data.users.hasAny([request.auth.uid]);
      allow create: if signedIn()
        && request.resource.data.users is list
        && request.resource.data.users.size() == 2
        && request.resource.data.users[0] < request.resource.data.users[1]
        && request.resource.data.users.hasAny([request.auth.uid])
        && matchId == pairId(request.resource.data.users[0], request.resource.data.users[1])
        && request.resource.data.status == 'active'
        && notBlocked(request.resource.data.users[0], request.resource.data.users[1])
        && get(/databases/$(database)/documents/likes/$(request.resource.data.users[0] + '_' + request.resource.data.users[1])).data.action == 'like'
        && get(/databases/$(database)/documents/likes/$(request.resource.data.users[1] + '_' + request.resource.data.users[0])).data.action == 'like';
      allow update: if signedIn()
        && resource.data.users.hasAny([request.auth.uid])
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'lastMessageAt', 'lastMessagePreview'])
        && request.resource.data.status in ['active', 'unmatched', 'closed'];
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isMatchMember(matchId);
        allow create: if isMatchMember(matchId)
          && request.resource.data.matchId == matchId
          && request.resource.data.type in ['text', 'game_share', 'system']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 2000
          && (request.resource.data.senderId == request.auth.uid || request.resource.data.senderId == 'system');
        allow update, delete: if false;
      }

      match /gameAnswers/{answerId} {
        allow read: if isMatchMember(matchId);
        allow create, update: if isMatchMember(matchId)
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.messageId is string
          && request.resource.data.choice in ['a', 'b']
          && exists(/databases/$(database)/documents/matches/$(matchId)/messages/$(request.resource.data.messageId))
          && get(/databases/$(database)/documents/matches/$(matchId)/messages/$(request.resource.data.messageId)).data.type == 'game_share';
        allow delete: if isMatchMember(matchId) && resource.data.uid == request.auth.uid;
      }
    }

    match /quizResults/{uid} {
      allow read, create, update, delete: if owner(uid);
    }

    match /wyrAnswers/{uid} {
      allow get: if owner(uid) || (signedIn() && exists(/databases/$(database)/documents/matches/$(pairId(uid, request.auth.uid)))
        && get(/databases/$(database)/documents/matches/$(pairId(uid, request.auth.uid))).data.status == 'active');
      allow list: if false;
      allow create, update, delete: if owner(uid);
    }

    match /gameAnswers/{uid} {
      allow read: if signedIn();
      allow write: if owner(uid);
    }

    function validNote(text) {
      return text is string && text.size() > 0 && text.size() <= 180;
    }
    function validDesign(design) {
      return design.keys().hasOnly(['color', 'ink', 'accent', 'pattern'])
        && design.pattern in ['solid', 'dots', 'stripes', 'grid', 'stars', 'waves', 'plaid', 'confetti']
        && design.color is string && design.color.size() <= 20
        && design.ink is string && design.ink.size() <= 20
        && design.accent is string && design.accent.size() <= 20;
    }
    function validReply(reply) {
      return reply.keys().hasOnly(['fromUid', 'text', 'createdAt'])
        && reply.fromUid == request.auth.uid
        && validNote(reply.text)
        && reply.createdAt is int;
    }

    // Sender's copy. The catcher's id is not stored here, so the sender cannot read who received it.
    match /paperPlanes/{planeId} {
      allow read: if signedIn() && resource.data.fromUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'design', 'text', 'createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && validNote(request.resource.data.text)
        && validDesign(request.resource.data.design)
        && request.resource.data.createdAt is int;
      allow update: if signedIn()
        && !('reply' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply'])
        && validReply(request.resource.data.reply)
        && exists(/databases/$(database)/documents/paperInboxes/$(request.auth.uid)/planes/$(planeId));
      allow delete: if signedIn() && resource.data.fromUid == request.auth.uid;
    }

    // Recipient's copy. Only they can read it, which is what keeps the catcher hidden from the sender.
    match /paperInboxes/{uid}/planes/{planeId} {
      allow read: if owner(uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid', 'toUid', 'design', 'text', 'createdAt', 'planeId'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid == uid
        && request.resource.data.toUid != request.resource.data.fromUid
        && request.resource.data.planeId == planeId
        && validNote(request.resource.data.text)
        && validDesign(request.resource.data.design)
        && request.resource.data.createdAt is int
        && exists(/databases/$(database)/documents/paperPlanes/$(planeId))
        && get(/databases/$(database)/documents/paperPlanes/$(planeId)).data.fromUid == request.auth.uid;
      allow update: if owner(uid)
        && !('reply' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reply'])
        && validReply(request.resource.data.reply);
      allow delete: if owner(uid);
    }

    match /blocks/{blockId} {
      allow read: if signedIn() && (resource.data.blockerUid == request.auth.uid || resource.data.blockedUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.blockerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid
        && blockId == request.resource.data.blockerUid + '_' + request.resource.data.blockedUid;
      allow delete: if signedIn() && resource.data.blockerUid == request.auth.uid;
      allow update: if false;
    }

    match /userReports/{reportId} {
      allow create: if signedIn()
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.reportedUid is string
        && request.resource.data.reportedUid != request.auth.uid
        && request.resource.data.reason in ['harassment', 'fake', 'scam', 'underage', 'other']
        && request.resource.data.details is string
        && request.resource.data.details.size() <= 1000
        && request.resource.data.status == 'new';
      allow read: if signedIn() && resource.data.reporterUid == request.auth.uid;
      allow update: if false;
      allow delete: if signedIn() && resource.data.reporterUid == request.auth.uid;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
