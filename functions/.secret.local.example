# Server-side secrets for live safety reports. Copy to functions/.secret.local
# (gitignored) for the emulator. Never put these in web/.env.
#
# For the deployed function:
#   firebase functions:secrets:set CLAUDE_CODE_OAUTH_TOKEN
#
# Live search also needs the Claude Code CLI (`claude`) on the machine that
# runs the function. Cloud Functions does not include that CLI.
CLAUDE_CODE_OAUTH_TOKEN=
TAVILY_API_KEY=
